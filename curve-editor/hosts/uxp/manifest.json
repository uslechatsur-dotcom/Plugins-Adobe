{
  "manifestVersion": 5,
  "id": "com.legolasplus.curveeditor",
  "name": "Legolas+ Curve Editor",
  "version": "0.2.1",
  "main": "index.html",
  "host": { "app": "premierepro", "minVersion": "25.6.0" },
  "entrypoints": [
    {
      "type": "panel",
      "id": "legolasPanel",
      "label": { "default": "Legolas+ Curves" },
      "minimumSize": { "width": 420, "height": 380 },
      "preferredDockedSize": { "width": 640, "height": 520 },
      "preferredFloatingSize": { "width": 720, "height": 560 }
    }
  ],
  "requiredPermissions": { "localFileSystem": "plugin" }
}
